# MySQL Connection URL for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&pool_timeout=20
DATABASE_URL="mysql://root:password@localhost:3306/cod_manager?connection_limit=10&pool_timeout=20"

# Application Secret for JWT / Auth
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"

# Webhook secret for courier verification
COURIER_WEBHOOK_SECRET="courier-webhook-secret-token"
