datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  COURIER
}

enum OrderStatus {
  NEW
  CONFIRMED
  CANCELLED
  NO_ANSWER
  SHIPPED
  DELIVERED
  RETURNED
}

model User {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(191)
  email          String    @unique @db.VarChar(191)
  password       String    @db.VarChar(255)
  role           Role      @default(AGENT)
  assignedOrders Order[]   @relation("AgentAssignedOrders")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id          String      @id @default(uuid())
  sku         String      @unique @db.VarChar(100)
  name        String      @db.VarChar(255)
  description String?     @db.Text
  costPrice   Decimal     @db.Decimal(10, 2)
  salePrice   Decimal     @db.Decimal(10, 2)
  stock       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([categoryId])
  @@index([stock])
  @@map("products")
}

model Courier {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(191)
  phone       String    @db.VarChar(50)
  apiEndpoint String?   @db.VarChar(255)
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("couriers")
}

model Order {
  id             String      @id @default(uuid())
  customerName   String      @db.VarChar(191)
  phone          String      @db.VarChar(50)
  city           String      @db.VarChar(100)
  address        String      @db.Text
  shippingNote   String?     @db.Text
  totalAmount    Decimal     @db.Decimal(10, 2)
  status         OrderStatus @default(NEW)
  attemptsCount  Int         @default(0)
  trackingNumber String?     @unique @db.VarChar(100)
  courierId      String?
  courier        Courier?    @relation(fields: [courierId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?       @relation("AgentAssignedOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([city])
  @@index([assignedToId])
  @@index([courierId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([city, status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
