datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  AGENT
  COURIER
}

enum OrderStatus {
  NEW
  CONFIRMED
  CANCELLED
  NO_ANSWER
  SHIPPED
  DELIVERED
  RETURNED
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum SupplyOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model User {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(191)
  email          String   @unique @db.VarChar(191)
  password       String   @db.VarChar(255)
  role           Role     @default(AGENT)
  assignedOrders Order[]  @relation("AgentAssignedOrders")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([role])
  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(191)
  slug        String    @unique @db.VarChar(191)
  description String?   @db.Text
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Supplier {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(191)
  phone        String        @db.VarChar(50)
  city         String        @db.VarChar(100)
  address      String?       @db.Text
  balanceDue   Decimal       @default(0.00) @db.Decimal(10, 2)
  products     Product[]
  supplyOrders SupplyOrder[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("suppliers")
}

model Product {
  id               String            @id @default(uuid())
  sku              String            @unique @db.VarChar(100)
  name             String            @db.VarChar(255)
  description      String?           @db.Text
  costPrice        Decimal           @db.Decimal(10, 2)
  salePrice        Decimal           @db.Decimal(10, 2)
  stock            Int               @default(0)
  imageUrl         String?           @db.VarChar(500)
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplierId       String?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems       OrderItem[]
  supplyOrderItems SupplyOrderItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([supplierId])
  @@index([stock])
  @@map("products")
}

model Courier {
  id            String   @id @default(uuid())
  name          String   @db.VarChar(191)
  phone         String   @db.VarChar(50)
  apiEndpoint   String?  @db.VarChar(255)
  apiKey        String?  @db.VarChar(255)
  webhookSecret String?  @db.VarChar(255)
  ipWhitelist   String?  @db.Text
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("couriers")
}

model Order {
  id             String               @id @default(uuid())
  customerName   String               @db.VarChar(191)
  phone          String               @db.VarChar(50)
  city           String               @db.VarChar(100)
  address        String               @db.Text
  shippingNote   String?              @db.Text
  totalAmount    Decimal              @db.Decimal(10, 2)
  status         OrderStatus          @default(NEW)
  attemptsCount  Int                  @default(0)
  trackingNumber String?              @unique @db.VarChar(100)
  courierId      String?
  courier        Courier?             @relation(fields: [courierId], references: [id], onDelete: SetNull)
  assignedToId   String?
  assignedTo     User?                @relation("AgentAssignedOrders", fields: [assignedToId], references: [id], onDelete: SetNull)
  lastLatitude   Float?
  lastLongitude  Float?
  lastLocationAt DateTime?
  items          OrderItem[]
  invoice        Invoice?
  trackingEvents OrderTrackingEvent[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([city])
  @@index([assignedToId])
  @@index([courierId])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([city, status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderTrackingEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?     @db.Text
  latitude  Float?
  longitude Float?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_tracking_events")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @db.VarChar(50)
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subtotal      Decimal       @db.Decimal(10, 2)
  shippingCost  Decimal       @default(0.00) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        InvoiceStatus @default(PENDING)
  pdfUrl        String?       @db.VarChar(500)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("invoices")
}

model SupplyOrder {
  id          String            @id @default(uuid())
  supplierId  String
  supplier    Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  totalAmount Decimal           @db.Decimal(10, 2)
  status      SupplyOrderStatus @default(RECEIVED)
  note        String?           @db.Text
  items       SupplyOrderItem[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([supplierId])
  @@map("supply_orders")
}

model SupplyOrderItem {
  id            String      @id @default(uuid())
  supplyOrderId String
  supplyOrder   SupplyOrder @relation(fields: [supplyOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  unitCost      Decimal     @db.Decimal(10, 2)

  @@index([supplyOrderId])
  @@index([productId])
  @@map("supply_order_items")
}

model StoreSetting {
  id        String   @id @default("default")
  storeName String   @default("Atlas Boutique COD") @db.VarChar(191)
  phone     String   @default("0661000000") @db.VarChar(50)
  email     String?  @default("contact@atlasboutique.ma") @db.VarChar(191)
  address   String   @default("Bd Al Massira Al Khadra, Casablanca")
  currency  String   @default("MAD") @db.VarChar(10)
  logoUrl   String?  @db.VarChar(500)
  ice       String?  @default("002891823000045") @db.VarChar(50)
  taxNumber String?  @default("45129801") @db.VarChar(50)
  patente   String?  @default("34192045") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_settings")
}

model MetaIntegration {
  id                 String   @id @default("default")
  appId              String?  @db.VarChar(191)
  appSecret          String?  @db.VarChar(255)
  accessToken        String?  @db.Text
  instagramAccountId String?  @db.VarChar(191)
  adAccountId        String?  @db.VarChar(191)
  pageId             String?  @db.VarChar(191)
  isConnected        Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@map("meta_integrations")
}

model SocialPost {
  id            String    @id @default(uuid())
  mediaId       String    @unique @db.VarChar(191)
  caption       String?   @db.Text
  mediaType     String    @default("IMAGE") @db.VarChar(50)
  mediaUrl      String?   @db.Text
  permalink     String?   @db.VarChar(500)
  viewsCount    Int       @default(0)
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([viewsCount(sort: Desc)])
  @@map("social_posts")
}

